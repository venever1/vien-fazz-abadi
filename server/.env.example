PORT=3001
# CORS: boleh daftar lebih dari satu origin, pisahkan dengan koma.
# Contoh production (Cloudflare Pages):
# CORS_ORIGIN=https://dashboard.example.com,https://<preview>.pages.dev
CORS_ORIGIN=http://localhost:5173
# Wajib: gunakan secret acak yang panjang (min 32 byte hex = 64 char).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Kredensial seed (OPSIONAL, hanya untuk dev/test) ---
# Jika diset, password admin/staff dipaksa ke nilai ini saat server boot
# (idempotent). Jangan diset di production.
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=

# --- Rate limit login (OPSIONAL, default aman) ---
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX=5

# --- Turso / libSQL database (WAJIB untuk production) ---
# Buat database: turso db create <name>
# Dapatkan URL: turso db show <name>
# Dapatkan token: turso db tokens create <name>
# PENTING: NODE_ENV=production TANPA TURSO_DATABASE_URL akan MENOLAK start
# (mencegah data tersimpan di filesystem ephemeral dan hilang).
# TURSO_DATABASE_URL=libsql://<name>.turso.io
# TURSO_AUTH_TOKEN=

# --- Mode produksi ---
# NODE_ENV=production

# --- Smoke test (dijalankan lewat `npm run test:smoke`) ---
# SMOKE_ADMIN_PASSWORD harus diisi saat menjalankan smoke test.
# SMOKE_ADMIN_USER=admin
# SMOKE_BASE_URL=http://localhost:3001/api
# SMOKE_RATE_MAX=5
